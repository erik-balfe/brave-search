{
  "name": "brave-search",
  "version": "1.0.0",
  "description": "Typed Brave Search API wrapper: web, news, image, video, places and LLM grounding context.",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build:esm": "bun build src/index.ts --outdir dist/esm --target node --format esm --sourcemap=linked",
    "build:cjs": "bun build src/index.ts --outdir dist/cjs --target node --format cjs --sourcemap=linked",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "rm -rf dist && bun run build:esm && bun run build:cjs && bun run build:types",
    "typecheck": "bun check",
    "test": "bun test",
    "test:ci": "bun test --check",
    "release:major": "bun scripts/bump-version.ts major",
    "release:minor": "bun scripts/bump-version.ts minor",
    "release:patch": "bun scripts/bump-version.ts patch",
    "test:coverage": "bun test --coverage"
  },
  "keywords": [
    "brave",
    "brave-search",
    "web-search",
    "search",
    "search-engine",
    "news-search",
    "image-search",
    "api",
    "typescript",
    "web-api",
    "information-retrieval",
    "brave-api"
  ],
  "author": "erik.balfe@protonmail.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erik-balfe/brave-search.git"
  },
  "homepage": "https://github.com/erik-balfe/brave-search#readme",
  "bugs": {
    "url": "https://github.com/erik-balfe/brave-search/issues"
  },
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^24.0.0",
    "axios": "^1.21.0",
    "typescript": "^7.0.2"
  }
}
